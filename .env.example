# Forecast AI self-hosted configuration
# Copy to .env for local use. Never commit your real .env file.

# At least one LLM provider is required.
DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Optional live research sources.
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=
POLYGONSCAN_API_KEY=

TAVILY_API_KEY=
TAVILY_ENABLED=false

FACTSAI_API_KEY=
FACTSAI_ENABLED=false
FACTSAI_API_URL=https://deep-research-api.degodmode3-33.workers.dev/answer

# Public read-only prediction-market data.
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com

# Optional recommendation hand-off. Forecast AI does not authenticate or trade
# through Robinhood on the user's behalf.
ROBINHOOD_MCP_ENDPOINT=https://agent.robinhood.com/mcp/trading

# API server.
SERVER_HOST=0.0.0.0
SERVER_PORT=30000
SERVER_API_KEY=
PUBLIC_RATE_LIMIT_PER_HOUR=50
CORS_ALLOW_ORIGINS=*
MEMORY_STORE_DIR=memory_data

# Optional estimated-cost circuit breaker. Disabled by default.
LLM_SPEND_GUARD_ENABLED=false
DAILY_LLM_BUDGET_USD=10
MONTHLY_LLM_BUDGET_USD=50

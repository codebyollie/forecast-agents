{
  "name": "Forecast AI Agents",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "postCreateCommand": "pip install -e \".[dev]\"",
  "forwardPorts": [30000],
  "portsAttributes": {
    "30000": {
      "label": "FastAPI Server & Surveillance",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
